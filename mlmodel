## 4. Website (`app.py`) – Streamlit

The website:
- Shows input fields (Rating, Votes, Runtime, Year)
- On button click, **loads all saved ML modules**,
- Passes the new data through each model
- Gathers all predicted genres
- **Segregates** the results by category
- Displays a combined summary table

```python
import streamlit as st
import pandas as pd
import joblib
import os

# Page config
st.set_page_config(page_title="IMDb Genre Classifier", layout="wide"
st.title("🎬 IMDb Rating-Based Genre Classifier")
st.markdown("**Enter movie details and see which genre category it belongs to (predicted by all ML modules).**")

# ---------- Load saved artifacts ----------
MODEL_DIR = "models"

def load_models():
    models = {}
    for fname in os.listdir(MODEL_DIR):
        if fname.endswith("_model.pkl"):
            name = fname.replace("_model.pkl", "").replace("_", " ")
            models[name] = joblib.load(os.path.join(MODEL_DIR, fname)))
    return models

@st.cache_resource
def get_artifacts():
    le = joblib.load("models/genre_encoder.pkl")
    scaler = joblib.load("models/scaler.pkl")
    models = load_models()
    return le, scaler, models

try:
    le, scaler, models = get_artifacts()
except Exception as e:
    st.error(f"Error loading models: {e}")
    st.stop()

# ---------- Sidebar: Input fields ----------
st.sidebar.header("🎯 New Movie Input")
rating = st.sidebar.number_input("IMDb Rating", min_value=0.0, max_value=10.0, value=7.5, step=0.1)
votes = st.sidebar.number_input("Number of Votes", min_value=0, value=10000, step=100)
runtime = st.sidebar.number_input("Runtime (minutes)", min_value=1, value=120, step=1)
year = st.sidebar.number_input("Release Year", min_value=1900, max_value=2026, value=2015, step=1)

# ---------- Prediction ----------
if st.sidebar.button("Predict Category"):
    input_data = pd.DataFrame([[rating, votes, runtime, year]],
                               columns=["Rating", "Votes", "Runtime", "Year"])
    
    # Scale numeric features for models that need it
    input_scaled = scaler.transform(input_data)
    
    results = []
    
    # Run through ALL models
    for name, model in models.items():
        # Random Forest and XGBoost were trained on unscaled data
        if name in ["Random Forest", "XGBoost"]:
            pred_encoded = model.predict(input_data)[0]
        else:
            pred_encoded = model.predict(input_scaled)[0]
        
        genre = le.inverse_transform([pred_encoded])[0]
        results.append({"Model": name, "Predicted Category": genre})
    
    results_df = pd.DataFrame(results)
    
    # ---- Display all results ----
    st.subheader("✅ Predictions from All ML Modules")
    st.dataframe(results_df, use_container_width=True)
    
    # ---- Segregate by category ----
    st.subheader("📂 Segregated by Category")
    category_counts = results_df["Predicted Category"].value_counts().reset_index()
    category_counts.columns = ["Category", "Model Count"]
    
    # Show each category group
    for category in category_counts["Category"]:
        with st.expander(f"🎯 {category} ({category_counts[category_counts['Category'] == category]['Model Count'].values[0]} model(s))", expanded=True):
            group_df = results_df[results_df["Predicted Category"] == category]
            st.table(group_df)
    
    # Also show bar chart (visual segregation)
    st.bar_chart(category_counts.set_index("Category")["Model Count"])

else:
    st.info("👈 Enter values in the sidebar and click **Predict Category*..
```

