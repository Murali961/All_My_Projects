## 3. Training Code (`train_model.py`)

This script:
- Loads and cleans data
- Encodes the target `Genre`
- Trains **multiple classifiers** (Logistic Regression, Random Forest, SVM, KNN, XGBoost)
- Saves models + encoder + scaler for later use in the website

```python
import pandas as pd
import numpy as np
import joblib
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, classification_report

# Optional: XGBoost
try:
    from xgboost import XGBClassifier
    has_xgb = True
except ImportError:
    has_xgb = False


# ---------- 1. Load data ----------
df = pd.read_csv("imdb_movies.csv")

# Select useful columns
features = ["Rating", "Votes", "Runtime", "Year"]
target = "Genre"

df = df.dropna(subset=features + [target])    
X = df[features]
y = df[target]

# ---------- 2. Label encode target ----------
le = LabelEncoder()
y_encoded = le.fit_transform(y)

# ---------- 3. Train/test split ----------
X_train, X_test, y_train, y_test = train_test_split(
    X, y_encoded, test_size=0.2, random_state=42, stratify=y_encoded
)

# ---------- 4. Scale features ----------
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# ---------- 5. Define all models ----------
models = {
    "Logistic Regression": LogisticRegression(max_iter=1000, multi_class="multinomial"),
    "Random Forest": RandomForestClassifier(n_estimators=100, random_state=42),
    "SVM": SVC(kernel="rbf", probability=True),
    "KNN": KNeighborsClassifier(n_neighbors=5),
}
if has_xgb:
    models["XGBoost"] = XGBClassifier(eval_metric="mlogloss", use_label_encoder=False)


# ---------- 6. Train, evaluate, save ----------
for name, model in models.items():
    # Some models need scaled data; some can work with unscaled
    if name in ["Random Forest", "XGBoost"]:
        model.fit(X_train, y_train)
        y_pred = model.predict(X_test)
        acc = accuracy_score(y_test, y_pred)
        joblib.dump(model, f"models/{name.replace(' ', '_')}_model.pkl")
    else:
        model.fit(X_train_scaled, y_train)
        y_pred = model.predict(X_test_scaled)
        acc = accuracy_score(y_test, y_pred)
        joblib.dump(model, f"models/{name.replace(' ', '_')}_model.pkl")
        
    print(f"{name}: Accuracy = {acc:.4f}")
    print(classification_report(y_test, y_pred, target_names=le.classes_))
    
# Save preprocessing objects
joblib.dump(le, "models/genre_encoder.pkl")
joblib.dump(scaler, "models/scaler.pkl")
```

